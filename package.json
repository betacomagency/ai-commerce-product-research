{
  "name": "ai-commerce-product-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "harness:install": "node scripts/dsh.mjs plugin --profile web add .",
    "harness:web": "node scripts/dsh.mjs web"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.3.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.0",
    "openai": "^7.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
