# Server
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
DATA_DIR=./data
MAX_UPLOAD_MB=10

# LLM: "deepseek", "gemini", or "heuristic". Auto prefers DeepSeek, then Gemini.
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GEMINI_LLM_MODEL=gemini-flash-lite-latest

# Vision: Gemini is used when both an image and key are present.
VISION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-lite-latest

# Search: Tavily is preferred when configured; Brave Search HTML is the keyless fallback.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
MAX_SEARCH_QUERIES=7
MAX_SOURCES=8

# Research limits
FETCH_TIMEOUT_MS=12000
MAX_SOURCE_CHARS=12000
JOB_RETRY_ATTEMPTS=2

# Creative images: GPT Image routed through TokenRouter.
# Image generation is only triggered by the explicit UI/Harness action and uses TokenRouter balance.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_IMAGE_MODEL=openai/gpt-5-image
TOKENROUTER_IMAGE_QUALITY=medium
